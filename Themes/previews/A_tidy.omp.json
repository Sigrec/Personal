{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "foreground": "#EFAFA9",
          "template": "{{ .UserName }}@{{ .HostName }}"
        },
        {
          "type": "aspire",
          "style": "plain",
          "foreground": "#708b91",
          "template": "<#e1dfe5> ❚ </> {{ .Name }}",
          "properties": {
            "fetch_running": true,
            "cache_duration": "10s"
          },
          "foreground_templates": [
            "{{ if .Running }}#7aa37a{{ end }}"
          ]
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#a25a63",
          "template": "<#e1dfe5> ❚ </>{{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }}",
          "properties": {
            "branch_max_length": 1000,
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#bfa481{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#2c8585{{ end }}",
            "{{ if gt .Ahead 0 }}#8d88b6{{ end }}",
            "{{ if gt .Behind 0 }}#8d88b6{{ end }}"
          ]
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "#918a9f",
          "template": " {{ .Path }}",
          "properties": {
            "style": "full"
          }
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "root",
          "style": "plain",
          "foreground": "#7790a8",
          "template": "!"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#7790a8",
          "template": "❯"
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "#708b91",
          "template": " x{{ reason .Code }}",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#a25a63{{ end }}"
          ]
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#708b91",
          "template": " {{ .FormattedMs }} ",
          "properties": {
            "always_enabled": true,
            "threshold": 0
          }
        }
      ]
    }
  ]
}